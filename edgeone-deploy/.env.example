# EdgeOne Pages 环境变量（在 EdgeOne 控制台配置）

# ===== 安全 CORS 白名单（生产环境必填）=====
# 多个域名用逗号分隔
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== Supabase 数据库配置（必填）=====
# 在 https://supabase.com 创建项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ===== Coze 工作流配置（必填）=====
KM_COZE_TOKEN=pat_xxxxx

# 三步工作流 ID（在 Coze 工作流页面 URL 中获取）
WF_SPEC_ID=7679265032790327336
WF_PREVIEW_ID=7679271460304764991
WF_MULTI_ID=7679274717424959522

# 可选：管理员账号（注册后自动提升为管理员）
ADMIN_DESIGNER_ID=admin

# 可选：Coze App ID
COZE_APP_ID=

# 可选：速率限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# 可选：并发任务限制
KM_MAX_CONCURRENT=3