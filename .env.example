# Express.js 应用环境变量配置
# 请复制此文件为 .env 并填入真实的值

# ===== Coze API 配置（必需）=====
# Coze Personal Access Token（在 Coze 控制台获取）
KM_COZE_TOKEN=pat_xxxxxxxxxxxxxxxxxxxxxxxx

# 三步工作流 ID（在 Coze 工作流页面 URL 中获取）
WF_SPEC_ID=7679265032790327336
WF_PREVIEW_ID=7679271460304764991
WF_MULTI_ID=7679274717424959522

# 仿香工作流 ID
COPY_WORKFLOW_ID=7680825923813900314
TWEAK_WORKFLOW_ID=7680825923813900314

# ===== 安全 CORS 白名单（生产环境必填）=====
# 多个域名用逗号分隔，开发环境可留空
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== Supabase 数据库配置（必填）=====
# 在 https://supabase.com 创建项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ===== 可选配置 =====
# 服务器端口
PORT=3000

# 运行环境（development / production）
NODE_ENV=development

# Redis 模式（disabled / optional / required）
REDIS_MODE=optional

# Upstash Redis（可选，用于分布式限流）
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# 管理员账号（注册后自动提升为管理员）
ADMIN_DESIGNER_ID=admin

# 速率限制（可选）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# 并发任务数限制（可选）
KM_MAX_CONCURRENT=3